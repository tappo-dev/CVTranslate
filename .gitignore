# Dependencies and frontend caches. Keep package-lock.json and go.sum.
node_modules/
/web/dist/
/dist/
/build/
/out/
.vite/
.vite-temp/
.vitest-cache/
.cache/
.npm/
.pnpm-store/
.parcel-cache/
.turbo/
*.tsbuildinfo
.eslintcache
promo/

# Local application data, tooling ownership files and release packages.
/.local/
/release/

# Go build/debug output created outside the managed tooling directories.
/cvtranslate
/cvtranslate.exe
/bin/
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj
*.pdb
*.ilk
*.out
*.test
*.test.exe
__debug_bin*

# Test coverage and profiling output.
coverage/
.nyc_output/
/coverage.out
/coverage.txt
/coverage.xml
lcov.info
*.coverprofile
*.prof
*.pprof
*.trace

# Local environment and private key material. Keep sanitized templates only.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
.envrc
.direnv/
.credentials/
.secrets/
/credentials.json
/credentials.local.json
/secrets.json
/secrets.local.json
*.key
*.pem
*.cer
*.crt
*.der
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile

# Local databases, including SQLite journals and write-ahead logs.
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Logs, temporary files and editor backups.
*.log
*.tmp
*.temp
*.pid
*.pid.lock
*.bak
*.orig
*.rej
*.swp
*.swo
*~
/.tmp/
/tmp/
/temp/
.history/
.idea/
.fleet/
.vs/
.zed/
.vscode-test/
*.code-workspace

# Keep shared F5 configuration and project rules, not personal IDE state.
/.vscode/*
!/.vscode/extensions.json
!/.vscode/launch.json
!/.vscode/tasks.json
/.cursor/*
!/.cursor/rules/

# Windows and macOS filesystem metadata.
.DS_Store
._*
.AppleDouble/
.LSOverride
.fseventsd/
.Spotlight-V100/
.Trashes/
[Tt]humbs.db
[Tt]humbs.db:encryptable
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.dmp
*.stackdump
