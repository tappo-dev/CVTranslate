{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CVTranslate: Dev",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/cvtranslate",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags=dev",
      "args": [
        "--port=19328",
        "--data-dir=${workspaceFolder}/.local/dev",
        "--vite-url=http://127.0.0.1:19329"
      ],
      "preLaunchTask": "cvtranslate: prepare debug",
      "postDebugTask": "cvtranslate: stop debug"
    }
  ]
}
